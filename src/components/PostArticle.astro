---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from './Comments.astro';
import AuthorBox from './AuthorBox.astro';
import { formatDate } from '../lib/posts';
import { site } from '../site';
import { path } from '../lib/urls';
import 'katex/dist/katex.min.css';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const minutes = Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 220));
---
<Base title={post.data.title} description={post.data.description} image={post.data.socialImage} imageAlt={post.data.socialImageAlt || (post.data.socialImage ? post.data.title : undefined)} noindex={post.data.draft} article date={post.data.date} updated={post.data.updated}>
  <article class="article">
    {post.data.draft && <p class="archive-note">Draft — local styling preview only. Excluded from production.</p>}
    <header class="article-header">
      <a class="back-link" href={path('blog/')}>← Writing</a>
      <p class="eyebrow">{post.data.tags.join(' / ')}</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{minutes} min read</span>{post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}</div>
    </header>
    <div class="article-body">
      {post.data.toc && toc.length > 1 && <aside class="toc" data-toc><details open><summary>On this page</summary><nav aria-label="Table of contents"><ol>{toc.map(h => <li class:list={{ nested: h.depth === 3 }}><a data-toc-link href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details></aside>}
      <div class="prose"><Content /></div>
    </div>
    <!-- <div class="article-end"><span aria-hidden="true">∎</span><a href={path('blog/')}>Back to Writing →</a></div> -->
    <AuthorBox />
    {post.data.comments && site.disqusShortname && <Comments shortname={site.disqusShortname} identifier={post.data.commentId || post.id} url={new URL(Astro.url.pathname, Astro.site!).href} title={post.data.title} />}
  </article>
  <script>
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (toc) {
      const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
      const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((heading): heading is HTMLElement => Boolean(heading));
      let ticking = false;
      const updateActiveLink = () => {
        const current = headings.reduce((active, heading) => heading.getBoundingClientRect().top <= 140 ? heading : active, headings[0]);
        links.forEach(link => {
          if (link.hash === `#${current?.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
        ticking = false;
      };
      updateActiveLink();
      addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateActiveLink); ticking = true; }
      }, { passive: true });
    }
  </script>
</Base>
