---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  size?: 'compact' | 'prose' | 'wide';
  maxWidth?: number;
}

const { src, alt, caption, size = 'prose', maxWidth } = Astro.props;
const displayWidth = maxWidth ?? (size === 'compact' ? 520 : size === 'wide' ? 720 : 680);
const widths = [...new Set([
  Math.min(360, displayWidth, src.width),
  Math.min(displayWidth, src.width),
  Math.min(displayWidth * 2, src.width),
])].sort((a, b) => a - b);
const sizes = maxWidth
  ? `(min-width: ${maxWidth}px) ${maxWidth}px, calc(100vw - 40px)`
  : size === 'compact'
  ? '(min-width: 600px) 520px, calc(100vw - 40px)'
  : size === 'wide'
    ? '(min-width: 1250px) 720px, (min-width: 760px) 680px, calc(100vw - 40px)'
    : '(min-width: 760px) 680px, calc(100vw - 40px)';
---

<figure class:list={{ 'article-figure': true, [`article-figure-${size}`]: true }} style={maxWidth ? `max-width: ${maxWidth}px` : undefined}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} quality={90} />
  <figcaption>{caption}</figcaption>
</figure>
