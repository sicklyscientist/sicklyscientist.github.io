---
import { path } from '../lib/urls';
---

<aside class="author-box" aria-labelledby="author-heading">
  <img src={path('author-pic.jpg')} width="72" height="72" alt="" loading="lazy" />
  <div>
    <p class="author-label" id="author-heading">About the author</p>
    <p class="author-note">
      Kay is an AI engineer exploring the intersection of AI, biology, and healthcare, inspired by her own experience with rare-disease genetics.
    </p>
    <nav aria-label="Author links">
      <a href={path('about/')}>About me</a>
      <a href={path('contact/')}>Contact me</a>
    </nav>
  </div>
</aside>

<style>
  .author-box {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 20px;
    max-width: 680px;
    margin-top: 28px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font-size: .9375rem;
    line-height: 1.6;
  }
  img { display: block; width: 72px; height: 72px; object-fit: contain; }
  .author-label { font-size: .6875rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; }
  h2 { font-size: 1.125rem; letter-spacing: -.025em; line-height: 1.3; margin: 0 0 8px; }
  p { margin: 0 0 8px; }
  .author-note { color: var(--muted); font-size: .8125rem; line-height: 1.45; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; font-size: .75rem; line-height: 1.4; }
  a { text-decoration-color: var(--line); }
  a:hover { color: var(--focus); }
  @media (max-width: 600px) {
    .author-box { grid-template-columns: 48px minmax(0, 1fr); align-items: start; padding: 12px; gap: 10px; margin-top: 20px; }
    img { width: 48px; height: 48px; }
    .author-label { margin-bottom: 3px; }
    .author-note { margin-bottom: 0; line-height: 1.4; }
    nav { margin-top: 5px; }
  }
</style>
