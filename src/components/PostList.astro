---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';
import { path } from '../lib/urls';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
<ol class="post-list">
  {posts.map(post => <li>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <div>
      <h3><a href={path(`blog/${post.id}/`)}>{post.data.title}<span aria-hidden="true"> ↗</span></a></h3>
      <p>{post.data.description}</p>
      {post.data.tags.length > 0 && <span class="tags">{post.data.tags.join(' / ')}</span>}
    </div>
  </li>)}
</ol>
